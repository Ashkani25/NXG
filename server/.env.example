# Railway Deployment Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=2567
NODE_ENV=production

# Supabase (Database & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MongoDB (for sessions/cache - optional if using Supabase only)
# MONGO_URL=mongodb://mongo:27017
# DB_NAME=bermudanxg

# Security
JWT_SECRET=generate-a-secure-random-string-here
TICKET_SECRET=generate-another-secure-random-string-here
SESSION_SECRET=yet-another-secure-random-string

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=https://your-frontend-url.com,capacitor://localhost

# AI (Optional - for AI Assistant)
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-5

# Admin
ADMIN_API_KEY=your-admin-api-key
